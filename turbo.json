{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".svelte-kit/**"],
			"cache": true
		},
		"dev": {
			"dependsOn": ["^build"],
			"persistent": true,
			"cache": false
		},
		"lint": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"lint:fix": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"check": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"clean": {
			"cache": false
		}
	}
}

