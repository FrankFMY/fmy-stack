{
	"name": "@frankfmy/ui",
	"version": "1.1.2",
	"description": "Svelte 5 and Tailwind CSS components for forms, tables, overlays, feedback and themes.",
	"author": {
		"name": "Artem Prianishnikov",
		"email": "Pryanishnikovartem@gmail.com",
		"url": "https://frankfmy.com"
	},
	"license": "Apache-2.0",
	"type": "module",
	"svelte": "./dist/index.js",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"scripts": {
		"build": "rm -rf dist && svelte-package",
		"dev": "svelte-package --watch",
		"clean": "rm -rf dist",
		"lint": "biome lint src/",
		"lint:fix": "biome lint --write src/",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"package:check": "node scripts/verify-package-contract.mjs"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"ui",
		"components",
		"tailwindcss",
		"button",
		"input",
		"datatable",
		"toast",
		"modal",
		"theme"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FrankFMY/fmy-stack.git",
		"directory": "packages/ui"
	},
	"bugs": {
		"url": "https://github.com/FrankFMY/fmy-stack/issues"
	},
	"homepage": "https://github.com/FrankFMY/fmy-stack/tree/main/packages/ui#readme",
	"publishConfig": {
		"access": "public"
	}
}
