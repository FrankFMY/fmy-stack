{
	"name": "@frankfmy/db-utils",
	"version": "1.1.1",
	"description": "Drizzle ORM helpers for pagination, search, soft delete, transactions, bulk operations and seeding.",
	"author": {
		"name": "Artem Prianishnikov",
		"email": "Pryanishnikovartem@gmail.com",
		"url": "https://frankfmy.com"
	},
	"license": "Apache-2.0",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "bun build ./src/index.ts --outdir=./dist --target=bun --format=esm --sourcemap=external && bun x tsc --emitDeclarationOnly --declaration --outDir dist",
		"dev": "bun build ./src/index.ts --outdir=./dist --target=bun --format=esm --sourcemap=external --watch",
		"clean": "rm -rf dist",
		"lint": "biome lint src/",
		"lint:fix": "biome lint --write src/",
		"check": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"@frankfmy/core": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"bun-types": "^1.4.0"
	},
	"peerDependencies": {
		"drizzle-orm": ">=0.30.0"
	},
	"keywords": [
		"drizzle",
		"drizzle-orm",
		"orm",
		"database",
		"postgres",
		"sqlite",
		"mysql",
		"pagination",
		"search",
		"soft-delete"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FrankFMY/fmy-stack.git",
		"directory": "packages/db-utils"
	},
	"bugs": {
		"url": "https://github.com/FrankFMY/fmy-stack/issues"
	},
	"homepage": "https://github.com/FrankFMY/fmy-stack/tree/main/packages/db-utils#readme",
	"private": true
}
