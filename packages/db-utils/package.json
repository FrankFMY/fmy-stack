{
	"name": "@frankfmy/db-utils",
	"version": "1.1.0",
	"description": "Drizzle ORM helpers: BaseEntity, pagination, search, soft delete, transactions, bulk operations",
	"author": "Artyom Pryanishnikov <Pryanishnikovartem@gmail.com>",
	"license": "PolyForm-Shield-1.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "bun build ./src/index.ts --outdir=./dist --target=bun --format=esm --sourcemap=external && bun x tsc --emitDeclarationOnly --declaration --outDir dist",
		"dev": "bun build ./src/index.ts --outdir=./dist --target=bun --format=esm --sourcemap=external --watch",
		"clean": "rm -rf dist",
		"lint": "biome lint src/",
		"lint:fix": "biome lint --write src/",
		"check": "tsc --noEmit",
		"test": "bun test",
		"publish:github": "npm publish --registry=https://npm.pkg.github.com",
		"publish:npm": "npm publish --registry=https://registry.npmjs.org --access=public"
	},
	"dependencies": {
		"drizzle-orm": "^0.44.2",
		"@frankfmy/core": "^1.0.0"
	},
	"devDependencies": {
		"typescript": "^5.9.3",
		"bun-types": "^1.2.19"
	},
	"peerDependencies": {
		"drizzle-orm": ">=0.30.0"
	},
	"keywords": [
		"drizzle",
		"drizzle-orm",
		"orm",
		"database",
		"postgres",
		"sqlite",
		"mysql",
		"pagination",
		"search",
		"soft-delete"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FrankFMY/fmy-stack.git",
		"directory": "packages/db-utils"
	},
	"bugs": {
		"url": "https://github.com/FrankFMY/fmy-stack/issues"
	},
	"homepage": "https://github.com/FrankFMY/fmy-stack/tree/main/packages/db-utils#readme"
}
