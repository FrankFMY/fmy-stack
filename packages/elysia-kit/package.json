{
	"name": "@frankfmy/elysia-kit",
	"version": "1.0.4",
	"description": "ElysiaJS backend framework utilities: createApp, AuthPlugin, middleware, CRUD generation",
	"author": "Artyom Pryanishnikov <Pryanishnikovartem@gmail.com>",
	"license": "PolyForm-Shield-1.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "bun build ./src/index.ts --outdir=./dist --target=bun --format=esm --sourcemap=external && bun x tsc --emitDeclarationOnly --declaration --outDir dist",
		"dev": "bun build ./src/index.ts --outdir=./dist --target=bun --format=esm --sourcemap=external --watch",
		"clean": "rm -rf dist",
		"lint": "biome lint src/",
		"lint:fix": "biome lint --write src/",
		"check": "tsc --noEmit",
		"test": "echo 'No tests yet'",
		"publish:github": "npm publish --registry=https://npm.pkg.github.com",
		"publish:npm": "npm publish --registry=https://registry.npmjs.org --access=public"
	},
	"dependencies": {
		"elysia": "^1.3.2",
		"@elysiajs/jwt": "^1.3.0",
		"@elysiajs/cors": "^1.3.0",
		"@elysiajs/swagger": "^1.3.0",
		"@frankfmy/core": "^1.0.0",
		"@frankfmy/validation": "^1.0.1",
		"jose": "^6.1.3"
	},
	"devDependencies": {
		"typescript": "^5.9.3",
		"bun-types": "^1.2.19"
	},
	"peerDependencies": {
		"elysia": "^1.0.0"
	},
	"keywords": [
		"elysia",
		"elysiajs",
		"backend",
		"framework",
		"api",
		"rest",
		"jwt",
		"auth",
		"middleware"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FrankFMY/fmy-stack.git",
		"directory": "packages/elysia-kit"
	},
	"bugs": {
		"url": "https://github.com/FrankFMY/fmy-stack/issues"
	},
	"homepage": "https://github.com/FrankFMY/fmy-stack/tree/main/packages/elysia-kit#readme"
}
