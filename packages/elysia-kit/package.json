{
	"name": "@frankfmy/elysia-kit",
	"version": "1.1.2",
	"description": "Elysia helpers for application setup, authentication, middleware, errors, rate limits and responses.",
	"author": {
		"name": "Artem Prianishnikov",
		"email": "Pryanishnikovartem@gmail.com",
		"url": "https://frankfmy.com"
	},
	"license": "Apache-2.0",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"scripts": {
		"build": "rm -rf dist && bun build ./src/index.ts --outdir=./dist --target=bun --format=esm --sourcemap=external --packages external && bun x tsc -p tsconfig.build.json",
		"dev": "bun build ./src/index.ts --outdir=./dist --target=bun --format=esm --sourcemap=external --watch",
		"clean": "rm -rf dist",
		"lint": "biome lint src/",
		"lint:fix": "biome lint --write src/",
		"check": "tsc --noEmit",
		"test": "bun test",
		"package:check": "node scripts/verify-package-contract.mjs"
	},
	"dependencies": {
		"@elysiajs/jwt": "^1.4.2",
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/swagger": "^1.3.1",
		"jose": "^6.2.10"
	},
	"devDependencies": {
		"elysia": "^1.4.29",
		"typescript": "^6.0.3",
		"bun-types": "^1.4.0"
	},
	"peerDependencies": {
		"elysia": ">=1.4.29 <2"
	},
	"keywords": [
		"elysia",
		"elysiajs",
		"backend",
		"framework",
		"api",
		"rest",
		"jwt",
		"auth",
		"middleware"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FrankFMY/fmy-stack.git",
		"directory": "packages/elysia-kit"
	},
	"bugs": {
		"url": "https://github.com/FrankFMY/fmy-stack/issues"
	},
	"homepage": "https://github.com/FrankFMY/fmy-stack/tree/main/packages/elysia-kit#readme",
	"publishConfig": {
		"access": "public"
	}
}
