# FMY-Stack NPM Configuration
# ============================
#
# This file configures npm/bun to use GitHub Packages for @frankfmy scope
#
# For LOCAL development:
#   Set NPM_TOKEN in your environment (~/.bashrc or ~/.zshrc):
#   export NPM_TOKEN="ghp_YOUR_GITHUB_TOKEN"
#
# For CI/CD:
#   Add NPM_TOKEN as a secret in your CI platform

# Default: Use GitHub Packages for @frankfmy scope
# @frankfmy:registry=https://npm.pkg.github.com

# Auth token (from environment variable)
# //npm.pkg.github.com/:_authToken=${NPM_TOKEN}
