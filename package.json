{
	"name": "@frankfmy/platform",
	"version": "1.0.0",
	"private": true,
	"description": "Personal TypeScript toolkit monorepo: core utilities, validation, Svelte UI, Elysia helpers and Drizzle utilities.",
	"author": {
		"name": "Artem Prianishnikov",
		"email": "Pryanishnikovartem@gmail.com",
		"url": "https://frankfmy.com"
	},
	"license": "Apache-2.0",
	"homepage": "https://github.com/FrankFMY/fmy-stack#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FrankFMY/fmy-stack.git"
	},
	"bugs": {
		"url": "https://github.com/FrankFMY/fmy-stack/issues",
		"email": "Pryanishnikovartem@gmail.com"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "turbo run check",
		"test": "turbo run test",
		"packages:check": "node scripts/verify-npm-packages.mjs",
		"full": "biome check --write . && turbo run check && turbo run build",
		"clean": "turbo run clean && rm -rf node_modules",
		"copyright:add": "bun run scripts/add-copyright.ts",
		"audit": "bun audit",
		"verify": "bun run format:check && bun run lint && bun run check && bun run test && bun run build && bun run packages:check && bun audit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.3.0",
		"turbo": "^2.10.12",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.4.0",
	"engines": {
		"node": ">=20",
		"bun": ">=1.2"
	}
}
