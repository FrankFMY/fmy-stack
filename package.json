{
	"name": "@frankfmy/platform",
	"version": "1.0.0",
	"private": true,
	"description": "Enterprise TypeScript Platform — утилиты, UI компоненты, backend фреймворк",
	"author": "Artyom Pryanishnikov <Pryanishnikovartem@gmail.com> (https://github.com/FrankFMY)",
	"license": "PolyForm-Shield-1.0.0",
	"homepage": "https://github.com/FrankFMY/fmy-stack#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FrankFMY/fmy-stack.git"
	},
	"bugs": {
		"url": "https://github.com/FrankFMY/fmy-stack/issues",
		"email": "Pryanishnikovartem@gmail.com"
	},
	"workspaces": ["packages/*"],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "turbo run check",
		"test": "turbo run test",
		"clean": "turbo run clean && rm -rf node_modules",
		"copyright:add": "bun run scripts/add-copyright.ts",
		"publish:github": "bun run scripts/publish-all.ts github",
		"publish:npm": "bun run scripts/publish-all.ts npm"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@types/bun": "^1.3.3",
		"@types/node": "^24.10.1",
		"turbo": "^2.6.1",
		"typescript": "^5.9.3"
	},
	"packageManager": "bun@1.3.3",
	"engines": {
		"node": ">=20",
		"bun": ">=1.2"
	}
}

